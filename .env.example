# Copy to .env.local and fill in. Never commit .env.local.

# Optional. Without a key the planner still works: budget, timeline and vendor
# checklist are computed locally and the ideas section uses built-in suggestions.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Model used for the personalised-ideas call.
GEMINI_MODEL=gemini-3.8-flash

# Optional. Hard timeout for the Gemini call, in milliseconds (1000-30000).
GEMINI_TIMEOUT_MS=12000

# Optional. Requests allowed per client per window on /api/plan.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
